# Copy to .env and fill in private values. Exported environment variables take precedence.

# Remote model: primary for OCR, analysis and report generation (OpenAI-compatible API).
REMOTE_UFO_REVIEW_BASE_URL=https://your-provider.example/v1
REMOTE_UFO_REVIEW_API_KEY=
REMOTE_UFO_REVIEW_MODEL=your-remote-vision-language-model
# Remote backup for audio transcription (used only when the local model fails). Optional.
REMOTE_UFO_AUDIO_TRANSCRIPT_MODEL=

# Local models (OpenAI-compatible server, e.g. on localhost).
LOCAL_UFO_REVIEW_BASE_URL=http://localhost:8000/v1
LOCAL_UFO_REVIEW_API_KEY=
# Backup for OCR and analysis when the remote model fails. Optional but recommended.
LOCAL_UFO_REVIEW_MODEL=your-local-vision-language-model
# Primary for audio transcription and embeddings (these stay local).
LOCAL_UFO_AUDIO_TRANSCRIPT_MODEL=your-local-speech-recognition-model
LOCAL_UFO_EMBEDDING_MODEL=your-local-text-embedding-model

# Optional extra request parameters per task, as JSON, for providers that support them.
# Transcription and extraction need no hidden reasoning; turning it off is several times faster.
# REMOTE_UFO_OCR_PARAMS={"thinking":{"type":"disabled"}}
# REMOTE_UFO_EXTRACT_PARAMS={"thinking":{"type":"disabled"}}
# REMOTE_UFO_SYNTHESIS_PARAMS={"reasoning_effort":"low"}

# Optional tuning.
# UFO_OCR_CONCURRENCY=16
# UFO_EXTRACT_DOCUMENTS=4
# UFO_ANALYSIS_CONCURRENCY=8
# UFO_REQUEST_TIMEOUT=600
# UFO_SITE_URL=https://ufo-analysis.rittmuller.com
